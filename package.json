{
  "name": "cider",
  "version": "0.1.0",
  "private": true,
  "description": "Cider — Local AI coding IDE powered by DeepSeek",
  "scripts": {
    "predev": "npx pnpm@9.15.0 --filter @cider/shared build",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npx pnpm@9.15.0 --filter @cider/server dev",
    "dev:web": "npx pnpm@9.15.0 --filter @cider/web dev",
    "build": "npx pnpm@9.15.0 -r build",
    "desktop": "npx pnpm@9.15.0 --filter @cider/desktop dev",
    "db:push": "npx pnpm@9.15.0 --filter @cider/server db:push",
    "typecheck": "npx pnpm@9.15.0 -r typecheck",
    "install:all": "npx pnpm@9.15.0 install"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
